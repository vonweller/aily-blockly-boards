{
  "name": "XIAO nRF52840 Sense",
  "version": "1.0.0",
  "description": "Seeed Studio XIAO nRF52840 Sense，使用 Generic nRF52840 编译配置和 XIAO 板载引脚映射。",
  "compilerTool": "aily-builder",
  "core": "n-able-Arduino:arm-ble",
  "type": "n-able-Arduino:arm-ble:Generic_nRF52840",
  "mode": ["arduino"],
  "compilerParam": "compile --verbose -b n-able-Arduino:arm-ble:Generic_nRF52840 --build-property build.dfu_pattern=",
  "linkUploadParam": "probe-rs download --chip nRF52840_xxAA --verify ${'*.elf'};probe-rs reset --chip nRF52840_xxAA",
  "analogPins": [
    ["A0(D0)", "2"],
    ["A1(D1)", "3"],
    ["A2(D2)", "28"],
    ["A3(D3)", "29"],
    ["A4(D4)", "4"],
    ["A5(D5)", "5"]
  ],
  "digitalPins": [
    ["D0", "2"],
    ["D1", "3"],
    ["D2", "28"],
    ["D3", "29"],
    ["D4", "4"],
    ["D5", "5"],
    ["D6", "43"],
    ["D7", "44"],
    ["D8", "45"],
    ["D9", "46"],
    ["D10", "47"]
  ],
  "pwmPins": [
    ["D0", "2"],
    ["D1", "3"],
    ["D2", "28"],
    ["D3", "29"],
    ["D4", "4"],
    ["D5", "5"],
    ["D6", "43"],
    ["D7", "44"],
    ["D8", "45"],
    ["D9", "46"],
    ["D10", "47"]
  ],
  "servoPins": [
    ["D0", "2"],
    ["D1", "3"],
    ["D2", "28"],
    ["D3", "29"],
    ["D4", "4"],
    ["D5", "5"],
    ["D6", "43"],
    ["D7", "44"],
    ["D8", "45"],
    ["D9", "46"],
    ["D10", "47"]
  ],
  "serialPort": [["Serial", "Serial"]],
  "serialSpeed": [
    ["1200", "1200"],
    ["9600", "9600"],
    ["14400", "14400"],
    ["19200", "19200"],
    ["38400", "38400"],
    ["57600", "57600"],
    ["115200", "115200"],
    ["230400", "230400"],
    ["460800", "460800"],
    ["921600", "921600"]
  ],
  "spi": [["SPI", "SPI"]],
  "spiPins": {
    "SPI": [
      ["MOSI", "47"],
      ["MISO", "46"],
      ["SCK", "45"],
      ["SS", "44"]
    ]
  },
  "spiClockDivide": [
    ["2 (8MHz)", "SPI_CLOCK_DIV2"],
    ["4 (4MHz)", "SPI_CLOCK_DIV4"],
    ["8 (2MHz)", "SPI_CLOCK_DIV8"],
    ["16 (1MHz)", "SPI_CLOCK_DIV16"],
    ["32 (500KHz)", "SPI_CLOCK_DIV32"]
  ],
  "i2c": [["I2C", "Wire"]],
  "i2cPins": {
    "Wire": [
      ["SDA", "4"],
      ["SCL", "5"]
    ]
  },
  "i2cSpeed": [
    ["100kHz", "100000L"],
    ["250kHz", "250000L"],
    ["400kHz", "400000L"]
  ],
  "builtinLed": [
    ["LED_RED", "26"],
    ["LED_GREEN", "30"],
    ["LED_BLUE", "6"]
  ],
  "interruptPins": [
    ["D0", "2"],
    ["D1", "3"],
    ["D2", "28"],
    ["D3", "29"],
    ["D4", "4"],
    ["D5", "5"],
    ["D6", "43"],
    ["D7", "44"],
    ["D8", "45"],
    ["D9", "46"],
    ["D10", "47"]
  ],
  "interruptMode": [
    ["RISING", "RISING"],
    ["FALLING", "FALLING"],
    ["CHANGE", "CHANGE"]
  ]
}
